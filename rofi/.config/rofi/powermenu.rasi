@theme "/dev/null"

* {
    background-color:   #1E1E2E;
    background-alt:     #313244;
    text-color:         #CDD6F4;
    primary:            #8aadf4;
    urgent:             #F38BA8;
    font:               "ComicShannsMono Nerd Font Mono 12";
}

window {
    width:              200px;
    border-radius:      0px;
    padding:            12px;
    background-color:   @background-color;
    location:           center;
    x-offset:           0;
    y-offset:           0;
    border:             1px;
    border-color:       @background-alt;
}

/* Completely remove prompt and inputbar */
prompt {
    enabled: false;
}

entry {
    enabled: false;
}

mainbox {
    children:           [ listview ];
    background-color:   @background-color;
    spacing:            0px;
    padding:            0px;
}

listview {
    background-color:   @background-color;
    fixed-height:       true;
    layout:             vertical;
    dynamic:            true;
    cycle:              true;
    margin:             0px;
    spacing:            8px;
    lines:              5;
}

element {
    background-color:   transparent;
    border-radius:      8px;
    padding:            12px 12px;
}

element normal.normal {
    background-color:   transparent;
    text-color:         @text-color;
}

element selected.normal {
    background-color:   transparent;
    text-color:         @primary;
    border:             1px;
    border-color:       @primary;
    border-radius:      8px;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}
